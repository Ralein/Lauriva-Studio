# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
.claude/
.kotlin/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Coverage
/coverage

# Secrets: never commit signing credentials or API keys
android/key.properties
*.jks
*.keystore
.env
.env.*
!.env.example
*.pem

# Training checkpoints and large model states
tool/checkpoints/
*.pt
*.safetensors

# Local venv pinned to the app's ONNX Runtime (tool/eval/check_onnx_runtime_compat.py)
tool/eval/.ort-app/

# Raw Hugging Face downloads for tool/eval/build_multilingual_humans.py (365 MB); rebuildable.
tool/eval/data/.cache_multilingual/

# Release model binaries and checkpoints (hosted as release assets, never committed)
tool/release/*/*.onnx
tool/release/*/*.gz
tool/*_release/*.onnx
tool/student_release/work/
assets/models/*.onnx
assets/models/*.onnx.gz

# Generated dataset and benchmark output
out/

# Raw openly licensed source corpus (regenerated by tool/corpus/fetch)
tool/corpus/raw/
